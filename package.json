{
  "name": "vrata-ai",
  "displayName": "Врата AI",
  "description": "Подключение к Врата AI по API-ключу через штатный интерфейс VS Code.",
  "version": "0.1.21",
  "publisher": "vrata",
  "private": true,
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:vrata"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vrata",
          "title": "Врата AI",
          "icon": "media/vrata.svg"
        }
      ]
    },
    "views": {
      "vrata": [
        {
          "id": "vrata.panel",
          "name": "Врата AI",
          "type": "tree"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "vrata",
        "displayName": "Врата AI",
        "managementCommand": "vrata.manage"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vrata.openChat",
          "group": "navigation",
          "when": "view == vrata.panel"
        }
      ]
    },
    "commands": [
      {
        "command": "vrata.manage",
        "title": "Управление подключением",
        "category": "Врата AI"
      },
      {
        "command": "vrata.setApiKey",
        "title": "Вставить / заменить API-ключ",
        "category": "Врата AI"
      },
      {
        "command": "vrata.removeApiKey",
        "title": "Удалить локальный ключ",
        "category": "Врата AI"
      },
      {
        "command": "vrata.refreshModels",
        "title": "Обновить список моделей",
        "category": "Врата AI"
      },
      {
        "command": "vrata.selectModel",
        "title": "Выбрать модель",
        "category": "Врата AI"
      },
      {
        "command": "vrata.selectReasoning",
        "title": "Выбрать reasoning level",
        "category": "Врата AI"
      },
      {
        "command": "vrata.openChat",
        "title": "Открыть чат",
        "category": "Врата AI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vrata.openModelPicker",
        "title": "Выбрать модель в чате",
        "category": "Врата AI"
      },
      {
        "command": "vrata.copyDiagnostics",
        "title": "Скопировать диагностику",
        "category": "Врата AI"
      },
      {
        "command": "vrata.getApiKey",
        "title": "Получить ключ в боте",
        "category": "Врата AI"
      },
      {
        "command": "vrata.openWalkthrough",
        "title": "Как начать работу",
        "category": "Врата AI"
      },
      {
        "command": "vrata.utilitySettings",
        "title": "Настройки служебных запросов",
        "category": "Врата AI"
      },
      {
        "command": "vrata.showLogs",
        "title": "Открыть журнал",
        "category": "Врата AI"
      },
      {
        "command": "vrata.debugStaging",
        "title": "Проверить staging-каталог",
        "category": "Врата AI"
      }
    ],
    "walkthroughs": [
      {
        "id": "vrata.welcome",
        "title": "Врата AI",
        "description": "Подключите существующий API-ключ. URL и модели вручную вводить не нужно.",
        "steps": [
          {
            "id": "key",
            "title": "Вставьте API-ключ",
            "description": "Проверка ключа бесплатна: расширение только читает доступный каталог. Ключ хранится в защищённом хранилище VS Code.\n[Вставить API-ключ](command:vrata.setApiKey)\n[Получить ключ в боте](command:vrata.getApiKey)",
            "media": {
              "markdown": "media/connect.md"
            },
            "completionEvents": [
              "onContext:vrata.connected"
            ]
          },
          {
            "id": "model",
            "title": "Найдите Врата AI в Other Models",
            "description": "В штатном выборе модели откройте раздел `Other Models` и выберите провайдера `Врата AI`. Затем VS Code запомнит выбор для следующих чатов.\n[Открыть выбор модели](command:vrata.openModelPicker)",
            "media": {
              "markdown": "media/connect.md"
            }
          },
          {
            "id": "utility",
            "title": "Для чего нужна служебная модель",
            "description": "VS Code иногда отправляет фоновые запросы: например, для названия чата и других вспомогательных действий. Они тоже используют модель и могут расходовать баланс Врат AI. Нажмите кнопку ниже и выберите `Main Agent Model` — это значит «использовать выбранную модель основного агента Врата AI», а не отдельный чат или новый ключ.\n[Настроить служебную модель](command:vrata.utilitySettings)",
            "media": {
              "markdown": "media/utility.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:host": "bash test/run-host.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.0",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/v-lebedev/vrata-vscode.git"
  },
  "license": "UNLICENSED",
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Для подключения Врат AI настройте рабочее пространство как доверенное."
    },
    "virtualWorkspaces": false
  }
}
